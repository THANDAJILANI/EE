# ResearchMate AI Configuration

# Application
APP_NAME=ResearchMate AI
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
SECRET_KEY=dev-secret-key-researchmate-ai-super-secure-token-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite
DATABASE_URL=sqlite:///./researchmate.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://user:password@localhost:5432/researchmate_db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AI Configuration
# Providers: "groq", "openai", "demo"
AI_PROVIDER=demo
GROQ_API_KEY=
OPENAI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
DEMO_MODE=True
