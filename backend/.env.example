# ResearchMate AI Backend Configuration

# Application
APP_NAME=ResearchMate AI
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite in local directory.
# For PostgreSQL: postgresql://user:password@localhost:5432/researchmate
DATABASE_URL=sqlite:///./researchmate.db

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AI Provider Configuration
# Supported providers: "groq", "openai", "demo"
AI_PROVIDER=demo
GROQ_API_KEY=
OPENAI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# Demo Mode: Set to True to allow automatic fallback to Demo Heuristic analysis if keys are missing
DEMO_MODE=True
